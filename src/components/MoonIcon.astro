---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/* Crescent moon mark — a standalone echo of the moon in the background art. */}
<svg
  class={`moon-icon ${className}`}
  viewBox="0 0 84 84"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="moon-icon-grad" x1="10%" y1="0%" x2="95%" y2="100%">
      <stop offset="0%" stop-color="#F7ECD5" />
      <stop offset="100%" stop-color="#C9A668" />
    </linearGradient>
    <mask id="moon-icon-mask">
      <rect width="84" height="84" fill="#fff" />
      <circle cx="56" cy="24" r="22" fill="#000" />
    </mask>
  </defs>
  <circle cx="42" cy="32" r="22" fill="url(#moon-icon-grad)" mask="url(#moon-icon-mask)" />
</svg>
