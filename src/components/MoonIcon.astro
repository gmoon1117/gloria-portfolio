---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{/* Crescent moon mark — used next to "Moon" wherever your name appears prominently. */}
<svg
  class={`moon-icon ${className}`}
  viewBox="0 0 84 84"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <mask id="moon-icon-mask">
      <rect width="84" height="84" fill="#fff" />
      <circle cx="56" cy="24" r="22" fill="#000" />
    </mask>
  </defs>
  <circle cx="42" cy="32" r="22" fill="currentColor" mask="url(#moon-icon-mask)" />
</svg>
