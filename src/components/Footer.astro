---
import { site } from '../data/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div>
      <p class="eyebrow">Let’s connect</p>
      <a href={`mailto:${site.email}`} class="footer-email">{site.email}</a>
    </div>
    <div class="footer-links">
      <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
      <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; {year} {site.fullName}</span>
    <span>Designed &amp; built by {site.name}</span>
  </div>
</footer>
