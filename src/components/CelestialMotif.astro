  <circle cx="284" cy="128" r="1.4" fill="var(--gold)" opacity="0.5" />
  <circle cx="226" cy="150" r="1.2" fill="var(--accent)" opacity="0.4" />
  <circle cx="130" cy="140" r="1.2" fill="var(--gold)" opacity="0.35" />

