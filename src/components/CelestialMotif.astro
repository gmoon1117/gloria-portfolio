    <linearGradient id="moon-grad" x1="10%" y1="0%" x2="90%" y2="100%">
      <stop offset="0%" stop-color="#E0B968" />
      <stop offset="100%" stop-color="#9C7324" />
    </linearGradient>
    <mask id="moon-mask">
      <rect width="320" height="240" fill="#fff" />
      <circle cx="265" cy="48" r="38" fill="#000" />
