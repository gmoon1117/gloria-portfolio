---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { forFun, site } from '../data/content';
---

<BaseLayout title={`For Fun — ${site.name}`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow page-heading">For Fun</p>
      <h1 class="page-heading">Outside of work</h1>
      <p class="muted page-heading" style="max-width: 520px;">
        A few things I spend time on when I’m not designing products.
      </p>

      <div class="fun-grid">
        {forFun.map((item) => (
          <div class="fun-item reveal">
            <PlaceholderImage label={item.title} ratio="1/1" />
            <h3>{item.title}</h3>
            <p class="muted">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
