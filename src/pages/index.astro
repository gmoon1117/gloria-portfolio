---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { home, caseStudies, otherWork, site } from '../data/content';
---

<BaseLayout title={site.tagline}>
  <div class="art-parallax" aria-hidden="true">
    <div class="art-parallax-layer" id="art-parallax-layer"></div>
  </div>

  <section class="hero">
    <div class="hero-intro">
      <div class="container">
        <h1 class="hero-name">{site.firstName} {site.lastName}</h1>
        <p class="hero-tagline">{home.introLine}</p>
      </div>
    </div>
    <div class="container">
      <div class="project-grid">
        {caseStudies.map((cs, i) => (
          <ProjectCard
            href={`/work/${cs.slug}`}
            label={cs.cardLabel}
            title={cs.title}
            summary={cs.summary}
            heroPlaceholderLabel={cs.heroPlaceholderLabel}
            index={`0${i + 1}`}
            featured={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section other-work-section" style="padding-top: 0;">
    <div class="container">
      <h2>Other work</h2>
      <div class="other-work-grid">
        {otherWork.map((item) => (
          <div class="other-work-card reveal">
            {item.tag && <span class="tag">{item.tag}</span>}
            <h3>{item.title}</h3>
            <p class="muted">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const artLayer = document.getElementById('art-parallax-layer');
  if (artLayer) {
    let ticking = false;
    const apply = () => {
      ticking = false;
      const doc = document.documentElement;
      const viewportH = window.innerHeight;
      const scrollable = Math.max(doc.scrollHeight - viewportH, 1);
      const progress = Math.min(Math.max(window.scrollY / scrollable, 0), 1);
      const maxPan = Math.max(artLayer.offsetHeight - viewportH, 0);
      artLayer.style.transform = `translate3d(0, -${progress * maxPan}px, 0)`;
    };
    const requestUpdate = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(apply);
      }
    };
    apply();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  }
</script>
