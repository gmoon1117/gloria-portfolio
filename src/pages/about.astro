---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { about, site } from '../data/content';
---

<BaseLayout title={`About — ${site.name}`}>
  <section class="section">
    <div class="container">
      <p class="eyebrow page-heading">About</p>
      <h1 class="page-heading">About me</h1>

      <div class="about-grid glass-panel">
        <PlaceholderImage label={about.photoPlaceholderLabel} ratio="1/1" />

        <div>
          {about.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          <a href={`/${about.resumeFileName}`} class="btn" target="_blank" rel="noopener noreferrer">
            Download my resume (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
