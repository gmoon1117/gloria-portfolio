---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderImage from '../../components/PlaceholderImage.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { caseStudies } from '../../data/content';
import type { CaseStudy } from '../../data/content';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs },
  }));
}

interface Props {
  cs: CaseStudy;
}

const { cs } = Astro.props;
---

<BaseLayout title={`${cs.title} — Gloria`} description={cs.summary}>
  <section class="section" style="padding-bottom: 32px;">
    <div class="container">
      <a href="/" class="muted" style="font-size: 0.9rem;">&larr; Back to work</a>
      <h1 style="margin-top: 16px;">{cs.title}</h1>
      <p class="muted" style="font-size: 1.1rem; max-width: 640px;">{cs.summary}</p>

      <div class="cs-meta">
        <div>
          <span class="label">Project type</span>
          {cs.projectType}
        </div>
        <div>
          <span class="label">My role</span>
          {cs.myRoleLabel}
        </div>
        <div>
          <span class="label">Timeline</span>
          {cs.timeline}
        </div>
      </div>

      <PlaceholderImage label={cs.heroPlaceholderLabel} ratio="16/9" />
    </div>
  </section>

  <section class="cs-section">
    <div class="container">
      <h2>Context &amp; problem</h2>
      <p>{cs.context}</p>
    </div>
  </section>

  <section class="cs-section">
    <div class="container">
      <h2>My role</h2>
      <p>{cs.myRole}</p>
    </div>
  </section>

  <section class="cs-section">
    <div class="container">
      <h2>Process</h2>
      <h3>Research</h3>
      <p>{cs.process.research}</p>
      <PlaceholderImage label="Research artifact — notes, synthesis, or interview highlights" ratio="16/9" />

      <h3 style="margin-top: 32px;">Iterations</h3>
      <p>{cs.process.iterations}</p>
      <PlaceholderImage label="Early concepts / wireframes / iteration screenshots" ratio="16/9" />
    </div>
  </section>

  <section class="cs-section">
    <div class="container">
      <h2>Key design decisions &amp; why</h2>
      <div class="decision-list">
        {cs.decisions.map((d) => (
          <div class="decision">
            <h3>{d.title}</h3>
            <p class="muted">{d.why}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {cs.beforeAfter && (
    <section class="cs-section">
      <div class="container">
        <h2>Before &amp; after</h2>
        <BeforeAfter beforeLabel={cs.beforeAfter.beforeLabel} afterLabel={cs.beforeAfter.afterLabel} />
      </div>
    </section>
  )}

  <section class="cs-section">
    <div class="container">
      <h2>Outcome</h2>
      <p>{cs.outcome}</p>
    </div>
  </section>

  <section class="cs-section">
    <div class="container">
      <h2>What I’d do next</h2>
      <p>{cs.next}</p>
    </div>
  </section>
</BaseLayout>
